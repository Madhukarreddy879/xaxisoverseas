{
  "name": "xaxisoverseas",
  "main": "./worker.js",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ZEPTOMAIL_API_URL": "https://cpaas.zoho.in/v1.1/email",
    "ZEPTOMAIL_AGENT_ALIAS": "7cfc3c65bb67e8ee",
    "ZEPTOMAIL_FROM": "info@xaxisoverseas.com",
    "ZEPTOMAIL_TO": "campussconnects@gmail.com"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
